{
  "name": "local-translate-addon",
  "version": "2.0.1",
  "description": "macOS Translation.framework via napi-rs",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "entry.js",
    "binding.js",
    "binding.d.ts"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --js binding.js --dts binding.d.ts && npm run strip:node",
    "build:debug": "napi build --platform --js binding.js --dts binding.d.ts",
    "prepublishOnly": "napi prepublish -t npm",
    "universal": "napi universal",
    "version": "napi version",
    "test": "node --test __test__/test.mjs __test__/esm.test.mjs",
    "build:universal": "napi build --platform --release --target aarch64-apple-darwin --js binding.js --dts binding.d.ts && napi build --platform --release --target x86_64-apple-darwin --js binding.js --dts binding.d.ts && napi universal -d . && npm run strip:node",
    "strip:node": "strip -x local-translate-addon.darwin-*.node"
  },
  "napi": {
    "name": "local-translate-addon",
    "triples": {
      "defaults": false,
      "additional": [
        "universal-apple-darwin"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">= 18"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "optionalDependencies": {
    "local-translate-addon-darwin-universal": "1.0.4"
  }
}
